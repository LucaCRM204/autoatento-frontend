# ============================================
# AUTOATENTO — Variables de entorno (frontend único)
# Copiar a .env y completar. Un solo deploy atiende a todos los clientes:
# el tenant se resuelve por el dominio (GET /api/public/tenant?host=...).
# ============================================

# URL del backend, INCLUYENDO el /api al final.
# Ejemplo local:      http://localhost:3001/api
# Ejemplo producción: https://api.autoatento.com/api
VITE_API_URL=http://localhost:3001/api

# Solo desarrollo: tenant a usar cuando la app corre en localhost / 127.0.0.1.
# También se puede elegir con ?tenant=<slug> en la URL (queda guardado en la pestaña)
# o entrando por http://<slug>.localhost:5173 si ese host está en los dominios del tenant.
VITE_DEV_TENANT=tenant-a

# Ya NO se usa: la URL del bot sale de la config de cada tenant (config.wa_bot_url).
# VITE_WHATSAPP_BOT_URL=
